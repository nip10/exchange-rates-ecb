{
  "name": "exchange-rates-ecb",
  "license": "MIT",
  "version": "2.0.0",
  "type": "module",
  "description": "Utility package to fetch exchange rates from the ECB",
  "keywords": [
    "exchange-rates",
    "ecb"
  ],
  "author": {
    "name": "Diogo Cardoso",
    "email": "hi@diogocardoso.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nip10/exchange-rates-ecb.git"
  },
  "bugs": {
    "url": "https://github.com/nip10/exchange-rates-ecb/issues"
  },
  "homepage": "https://github.com/nip10/exchange-rates-ecb#readme",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "format": "prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json)\"",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "release": "pnpm run build && changeset publish",
    "changeset": "changeset"
  },
  "dependencies": {
    "fast-xml-parser": "^5.3.3",
    "got": "^14.6.5"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "jiti": "^2.6.1",
    "nock": "^14.0.10",
    "prettier": "^3.7.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0",
    "vitest": "^4.0.16",
    "vitest-github-actions-reporter": "^0.11.1"
  },
  "pnpm": {
    "overrides": {
      "braces@<3.0.3": ">=3.0.3",
      "micromatch@<4.0.8": ">=4.0.8",
      "@babel/runtime@<7.26.10": ">=7.26.10",
      "brace-expansion@>=1.0.0 <=1.1.11": ">=1.1.12",
      "js-yaml@<3.14.2": ">=3.14.2"
    }
  }
}
