{
  "name": "exchange-rates-ecb",
  "license": "MIT",
  "version": "1.0.4",
  "description": "Utility package to fetch exchange rates from the ECB",
  "keywords": [
    "exchange-rates",
    "ecb"
  ],
  "author": {
    "name": "Diogo Cardoso",
    "email": "hi@diogocardoso.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nip10/exchange-rates-ecb.git"
  },
  "bugs": {
    "url": "https://github.com/nip10/exchange-rates-ecb/issues"
  },
  "homepage": "https://github.com/nip10/exchange-rates-ecb#readme",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "format": "prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json)\"",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "release": "pnpm run build && changeset publish",
    "changeset": "changeset"
  },
  "dependencies": {
    "fast-xml-parser": "^5.3.3",
    "got": "^14.6.5"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "@vitest/ui": "^4.0.16",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "nock": "^14.0.10",
    "prettier": "^3.7.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0",
    "vitest": "^4.0.16",
    "vitest-github-actions-reporter": "^0.11.1"
  }
}
